            { "weight": 0.4, "log": "자격증 시험에 떨어졌다." }
          ] },
        { "text": "야간 대학을 다닌다", "next": "pandemic",
          "set": { "skill": "skill + 1", "assets": "assets - 800", "health": "health - 3" }, "log": "일하면서 야간 대학을 다녔다." }
