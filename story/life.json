    "income": 0,
    "partner_income": 0,
    "assets": 300,
    "debt": 0,
    "deposit": 0,
    "house_value": 0,
    "pension": 0,
    "married": 0,
    "children": 0,
    "in_seoul": 0,
    "own_home": 0,
    "student": 0,
