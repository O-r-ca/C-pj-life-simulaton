            { "weight": 0.15,
              "set": { "health": "health - 12", "assets": "assets - 300" }, "log": "감염병에 걸려 한동안 크게 앓았다." }
          ] },
        { "text": "이 기회에 다른 길을 준비한다", "next": "career",
          "set": { "skill": "skill + 1", "income": "income * 0.85" }, "log": "일을 줄이고 온라인으로 새 기술을 배웠다." }
      ]
    },

    {
