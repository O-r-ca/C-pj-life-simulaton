      "choices": [
        { "text": "지역 기업 인턴을 한다", "next": "first_job",
          "set": { "skill": "skill + 1" }, "log": "지역 기업에서 인턴을 했다." },
        { "text": "서울로 편입을 준비한다", "next": "first_job",
          "outcomes": [
            { "weight": 0.35, "set": { "in_seoul": 1, "income": 1800, "skill": "skill + 1" }, "log": "서울의 대학으로 편입했다." },
            { "weight": 0.65, "log": "편입에 실패하고 고향에서 졸업했다." }
          ] }
      ]
