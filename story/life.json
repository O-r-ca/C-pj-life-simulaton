          "set": { "in_seoul": 0, "student": 1, "income": 1500 }, "log": "고향 근처 대학에 진학했다." },
        { "text": "바로 취업한다", "next": "early_job",
          "set": { "in_seoul": 0, "income": "2600 * (1 + local_wage_bonus)", "job_stable": 1 }, "log": "대학 대신 바로 취업했다. 연봉 {income}만원." }
